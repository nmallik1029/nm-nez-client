{
  "name": "nmnez",
  "private": true,
  "version": "0.1.16",
  "description": "Performance-focused Krunker client for Windows",
  "license": "GPL-3.0-or-later",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:ranked-preload": "vite build --config vite.ranked-preload.config.ts",
    "build": "npm run build:main && npm run build:preload && npm run build:ranked-preload",
    "start": "npm run build && set \"ELECTRON_RUN_AS_NODE=\" && electron .",
    "dist": "npm run verify && npm run build && electron-builder --win --publish never",
    "clean": "rimraf dist out",
    "tokens:dev": "node scripts/dev-tokens.mjs",
    "postinstall": "node scripts/fetch-electron.mjs",
    "electron:patch": "node scripts/fetch-electron.mjs --force"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.0",
    "electron": "44.0.0",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.8.9",
    "eslint": "^9.18.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
